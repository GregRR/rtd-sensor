{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rtd-sensor conformance v1 release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "format_version",
    "contract_version",
    "contract_status",
    "rtd_sensor_version",
    "files"
  ],
  "properties": {
    "artifact_type": {
      "const": "conformance_manifest"
    },
    "format_version": {
      "const": 1
    },
    "contract_version": {
      "const": 1
    },
    "contract_status": {
      "enum": [
        "draft",
        "stable"
      ]
    },
    "rtd_sensor_version": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
