{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rtd-sensor conformance v1 implementation claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "format_version",
    "contract_version",
    "claims"
  ],
  "properties": {
    "artifact_type": {
      "const": "conformance_claim"
    },
    "format_version": {
      "const": 1
    },
    "contract_version": {
      "const": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "identifier_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "acceptance_profile"
      ],
      "properties": {
        "capability_id": {
          "enum": [
            "conversion.temperature_to_resistance",
            "conversion.resistance_to_temperature"
          ]
        },
        "acceptance_profile": {
          "enum": [
            "binary64_reference",
            "binary32_compatible"
          ]
        },
        "model_ids": {
          "$ref": "#/$defs/identifier_list"
        },
        "fixture_ids": {
          "$ref": "#/$defs/identifier_list"
        }
      },
      "oneOf": [
        {
          "required": [
            "model_ids"
          ],
          "not": {
            "required": [
              "fixture_ids"
            ]
          }
        },
        {
          "required": [
            "fixture_ids"
          ],
          "not": {
            "required": [
              "model_ids"
            ]
          },
          "properties": {
            "acceptance_profile": {
              "const": "binary64_reference"
            }
          }
        }
      ]
    }
  }
}
