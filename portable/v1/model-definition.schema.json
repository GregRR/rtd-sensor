{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RTD-Sensor Portable Model Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "format_version",
    "model_kind",
    "definition"
  ],
  "properties": {
    "artifact_type": {
      "const": "portable_model_definition"
    },
    "format_version": {
      "const": 1
    },
    "model_kind": {
      "enum": [
        "characteristic_model",
        "callendar_van_dusen",
        "polynomial",
        "piecewise_polynomial"
      ]
    },
    "definition": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "model_kind": {
            "const": "characteristic_model"
          }
        }
      },
      "then": {
        "properties": {
          "definition": {
            "$ref": "#/$defs/characteristic_model_definition"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "model_kind": {
            "const": "callendar_van_dusen"
          }
        }
      },
      "then": {
        "properties": {
          "definition": {
            "$ref": "#/$defs/callendar_van_dusen_definition"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "model_kind": {
            "const": "polynomial"
          }
        }
      },
      "then": {
        "properties": {
          "definition": {
            "$ref": "#/$defs/polynomial_definition"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "model_kind": {
            "const": "piecewise_polynomial"
          }
        }
      },
      "then": {
        "properties": {
          "definition": {
            "$ref": "#/$defs/piecewise_polynomial_definition"
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "characteristic_model_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characteristic_id",
        "reference_resistance_ohms",
        "minimum_temperature_c",
        "maximum_temperature_c"
      ],
      "properties": {
        "characteristic_id": {
          "$ref": "#/$defs/identifier"
        },
        "reference_resistance_ohms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_temperature_c": {
          "type": "number"
        },
        "maximum_temperature_c": {
          "type": "number"
        }
      }
    },
    "callendar_van_dusen_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_resistance_ohms",
        "a",
        "b",
        "minimum_temperature_c",
        "maximum_temperature_c"
      ],
      "properties": {
        "reference_resistance_ohms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "a": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "c": {
          "type": "number"
        },
        "minimum_temperature_c": {
          "type": "number"
        },
        "maximum_temperature_c": {
          "type": "number"
        }
      }
    },
    "polynomial_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_resistance_ohms",
        "reference_temperature_c",
        "coefficients",
        "minimum_temperature_c",
        "maximum_temperature_c"
      ],
      "properties": {
        "reference_resistance_ohms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_temperature_c": {
          "type": "number"
        },
        "coefficients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "number"
          }
        },
        "minimum_temperature_c": {
          "type": "number"
        },
        "maximum_temperature_c": {
          "type": "number"
        }
      }
    },
    "piecewise_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_temperature_c",
        "maximum_temperature_c",
        "coefficients",
        "temperature_origin_c"
      ],
      "properties": {
        "minimum_temperature_c": {
          "type": "number"
        },
        "maximum_temperature_c": {
          "type": "number"
        },
        "coefficients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 13,
          "items": {
            "type": "number"
          }
        },
        "temperature_origin_c": {
          "type": "number"
        }
      }
    },
    "piecewise_polynomial_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_resistance_ohms",
        "reference_temperature_c",
        "segments",
        "continuity_adjustment_kind",
        "maximum_continuity_adjustment_ratio"
      ],
      "properties": {
        "reference_resistance_ohms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_temperature_c": {
          "type": "number"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/piecewise_segment"
          }
        },
        "continuity_adjustment_kind": {
          "const": "additive_resistance_ratio_offset"
        },
        "maximum_continuity_adjustment_ratio": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
